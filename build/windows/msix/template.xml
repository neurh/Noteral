<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="noteral"
        Arguments=""
        InstallLocation="C:\Program Files\Noteral\Noteral">
    </Installer>
    <PackageInformation
        PackageName="Noteral"
        PackageDisplayName="Noteral"
        PublisherName="CN=Noteral"
        PublisherDisplayName="Noteral"
        Version="0.1.0.0"
        PackageDescription="Local-first personal knowledge desktop app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.noteral.app"
                Description="Local-first personal knowledge desktop app"
                DisplayName="Noteral"
                ExecutableName="noteral"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Noteral</DisplayName>
            <PublisherDisplayName>Noteral</PublisherDisplayName>
            <Description>Local-first personal knowledge desktop app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="noteral.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
